{
	"compilerOptions": {
		"target": "es5",
		"outDir": "lib",
		"lib": ["dom", "dom.iterable", "esnext"],
		"declaration": true,
		"declarationDir": "lib",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react",
		"baseUrl": "./src",
		"paths": {
			"@assets/*": ["assets/*"],
			"@components/*": ["components/*"],
			"@constants/*": ["constants/*"],
			"@hooks/*": ["hooks/*"],
			"@contexts/*": ["contexts/*"],
			"@utils/*": ["utils/*"],
			"@interfaces/*": ["types/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib"]
}
