{
	"sourceType": "unambiguous",
	"presets": [
		[
			"@babel/preset-env",
			{
				"targets": {
					"chrome": 100
				}
			}
		],
		"@babel/preset-typescript",
		"@babel/preset-react"
	],
	"plugins": [
		[
			"babel-plugin-module-resolver",
			{
				"root": ".",
				"alias": {
					"@": "./src",
					"@assets": "./src/assets",
					"@components": "./src/components",
					"@hooks": "./src/hooks",
					"@contexts": "./src/contexts",
					"@constants": "./src/constants",
					"@interfaces": "./src/types",
					"@utils": "./src/utils",
					"@styles": "./src/styles",
					"@i18n": "./src/i18n",
					"@hoc": "./src/hoc"
				}
			}
		]
	]
}
